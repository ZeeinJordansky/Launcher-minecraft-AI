<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MintyLauncher.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C8CE8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#99A5F0" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#111319" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#17191D" />
      <Setter Property="Foreground" Value="#F1F2F4" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#282B30" />
      <Setter Property="Foreground" Value="#ECEEF1" />
      <Setter Property="BorderBrush" Value="#393D44" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.14" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#34383F" />
      <Setter Property="BorderBrush" Value="#50555E" />
    </Style>
    <Style Selector="Window.no-animations Button">
      <Setter Property="Transitions">
        <Transitions />
      </Setter>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#30333A" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#202227" />
      <Setter Property="Foreground" Value="#F1F2F4" />
      <Setter Property="BorderBrush" Value="#3A3D44" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#202227" />
      <Setter Property="Foreground" Value="#F1F2F4" />
      <Setter Property="BorderBrush" Value="#3A3D44" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinHeight" Value="42" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#D8DADE" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="#3A3D44" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
  </Application.Styles>
</Application>
