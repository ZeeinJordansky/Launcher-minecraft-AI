<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MintyLauncher.MainWindow"
        Title="Minty Launcher"
        WindowDecorations="None"
        CanResize="True"
        Width="1360"
        Height="840"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="220,*" RowDefinitions="*,72">
    <Border Grid.RowSpan="2" Background="#1D1F23" BorderBrush="#303238" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="22,22,18,24">
          <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}">
            <TextBlock Text="M" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="23"
                       FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="MINTY" FontSize="15" FontWeight="Black" LetterSpacing="1.8" />
            <TextBlock Text="GAME LAUNCHER" FontSize="9" Foreground="#9699A1" LetterSpacing="1.1" />
          </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,0,12,16" Spacing="3">
            <TextBlock Text="БИБЛИОТЕКА" Margin="10,4,0,7" FontSize="10"
                       FontWeight="Bold" Foreground="#858891" LetterSpacing="1.2" />
            <Button Classes="nav active" Tag="home" Click="Navigate_Click" Content="Главная" />
            <Button Classes="nav" Tag="instances" Click="Navigate_Click" Content="Сборки" />
            <Button Classes="nav" Tag="versions" Click="Navigate_Click" Content="Версии Minecraft" />
            <Button Classes="nav" Tag="mods" Click="Navigate_Click" Content="Моды и контент" />
            <Button Classes="nav" Tag="worlds" Click="Navigate_Click" Content="Миры и ресурсы" />

            <TextBlock Text="ИНСТРУМЕНТЫ" Margin="10,18,0,7" FontSize="10"
                       FontWeight="Bold" Foreground="#858891" LetterSpacing="1.2" />
            <Button Classes="nav" Tag="skin" Click="Navigate_Click" Content="Скины" />
            <Button Classes="nav" Tag="bedrock" Click="Navigate_Click" Content="Bedrock Edition" />
            <Button Classes="nav" Tag="accounts" Click="Navigate_Click" Content="Аккаунты" />
            <Button Classes="nav" Tag="diagnostics" Click="Navigate_Click" Content="Диагностика" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="12,0,12,14" Spacing="3">
          <Button Classes="nav" Tag="settings" Click="Navigate_Click" Content="Настройки" />
          <Border Margin="4,10,4,0" Padding="12" CornerRadius="10"
                  Background="#25272C" BorderBrush="#35383F" BorderThickness="1">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
                <TextBlock Text="ЗАЩИТА ОБНОВЛЕНИЙ" FontSize="9" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="Подпись и хэш проверяются перед запуском установщика."
                         FontSize="10" Foreground="#A1A4AC" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowSpan="2" RowDefinitions="68,*,66">
      <Border Grid.Row="0" Background="#202227" BorderBrush="#303238" BorderThickness="0,0,0,1"
              PointerPressed="TitleBar_PointerPressed">
        <Grid Margin="24,0,18,0" ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="PageEyebrow" Text="MINTY LAUNCHER  /  01" FontSize="9"
                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" LetterSpacing="1.4" />
            <TextBlock x:Name="PageTitle" Text="Главная" FontSize="19" FontWeight="Bold" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Border MaxWidth="190" CornerRadius="8" Background="#292B31" BorderBrush="#3A3D44"
                    BorderThickness="1" Padding="10,7">
              <TextBlock x:Name="AccountBadge" Text="ОФЛАЙН • Player" FontSize="10"
                         FontWeight="Bold" Foreground="#D2D4D9" TextTrimming="CharacterEllipsis" />
            </Border>
            <Button Content="—" Width="34" Height="34" Padding="0" FontSize="16"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Minimize_Click" />
            <Button Content="□" Width="34" Height="34" Padding="0" FontSize="14"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Maximize_Click" />
            <Button Content="×" Width="34" Height="34" Padding="0" FontSize="16"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="Close_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageHost" Margin="28,26,28,26" />
      </ScrollViewer>

      <Border Grid.Row="2" Background="#202227" BorderBrush="#303238" BorderThickness="0,1,0,0"
              Padding="24,8">
        <Grid ColumnDefinitions="*,Auto,*" VerticalAlignment="Center">
          <StackPanel Spacing="3">
            <TextBlock x:Name="FooterStatus" Text="Готов к запуску" FontSize="11" FontWeight="SemiBold" />
            <TextBlock x:Name="FooterDetails" Text="MINTY 2.2.0  ·  JAVA EDITION"
                       FontSize="9" Foreground="#92959D" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" x:Name="ProgressPanel" Width="260" Spacing="4" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="ProgressLabel" Text="Загрузка" FontSize="9" />
              <TextBlock x:Name="ProgressValue" Grid.Column="1" Text="0%" FontSize="9"
                         Foreground="{DynamicResource AccentBrush}" />
            </Grid>
            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Height="5" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="Minecraft Java Edition"
                     HorizontalAlignment="Right" VerticalAlignment="Center"
                     FontSize="9" Foreground="#92959D" LetterSpacing=".4" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
