<Window x:Class="MintyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minty Launcher" Height="820" Width="1320" MinHeight="700" MinWidth="1060"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="#0C1412" Foreground="#EEF7F2" FontFamily="Segoe UI Variable Display" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Canvas" Color="#0C1412"/>
        <SolidColorBrush x:Key="Surface" Color="#121D19"/>
        <SolidColorBrush x:Key="Panel" Color="#192722"/>
        <SolidColorBrush x:Key="PanelRaised" Color="#20332C"/>
        <SolidColorBrush x:Key="Mint" Color="#A6E9C9"/>
        <SolidColorBrush x:Key="MintDim" Color="#70BDA0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EEF7F2"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9CAEA5"/>
        <SolidColorBrush x:Key="Line" Color="#2D4038"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#1B2A24"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#263B32"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Background" Value="{StaticResource Mint}"/>
            <Setter Property="Foreground" Value="#0C1913"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionSurface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="#C3F6DE"/>
                                <Setter TargetName="ActionSurface" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                <Setter TargetName="ActionSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.025" ScaleY="1.025"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionSurface" Property="Background" Value="#83D7B3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#21332C"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#0F1A16"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{StaticResource Mint}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ChoiceBox" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#0F1A16"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#30433A" BorderThickness="1" CornerRadius="12" Background="{StaticResource Canvas}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="74"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#101A16" CornerRadius="11,11,0,0" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid Margin="20,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="8" Background="{StaticResource Mint}" Margin="0,0,10,0">
                            <TextBlock Text="M" Foreground="#102018" FontSize="14" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="MINTY" FontSize="11" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <TextBlock Text="  /  LAUNCHER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <Border Background="#1D3028" CornerRadius="9" Padding="8,3" Margin="12,0,0,0">
                            <TextBlock Text="GLOBAL 2.0" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Mint}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="—" Width="38" Height="32" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Click="Minimize_Click"/>
                        <Button Content="□" Width="38" Height="32" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Click="Maximize_Click"/>
                        <Button Content="×" Width="38" Height="32" Background="Transparent" Foreground="#D18E80" BorderThickness="0" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="16,20,16,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                            <Grid Width="48" Height="48" Margin="0,0,12,0">
                                <Ellipse Fill="#244538"/>
                                <Ellipse Width="35" Height="35" Fill="{StaticResource Mint}"/>
                                <Path Data="M 12,25 C 13,14 23,10 35,12 C 34,24 26,34 16,33 C 20,27 24,23 30,18 C 23,21 18,24 12,30 Z" Fill="#123126" Stretch="Uniform" Margin="10"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ИГРОВОЙ ПРОФИЛЬ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="ProfileName" Text="Player" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="РАЗДЕЛЫ" FontSize="9" FontWeight="Bold" Foreground="#667970" Margin="6,0,0,8"/>
                        <StackPanel Grid.Row="3">
                            <Button Style="{StaticResource NavButton}" Click="HomeNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="18" Width="28"/><TextBlock Text="Главная" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Click="VersionsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="17" Width="28"/><TextBlock Text="Версии игры" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Click="ModsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="18" Width="28"/><TextBlock Text="Моды и сборки" VerticalAlignment="Center"/></StackPanel></Button>
                            <Button Style="{StaticResource NavButton}" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="16" Width="28"/><TextBlock Text="Настройки" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                        <Border Grid.Row="4" Background="#17251F" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock Text="JAVA RUNTIME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="JavaStatus" Text="Проверяется при запуске" FontSize="11" Foreground="{StaticResource Mint}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,28,30,30">
                    <Grid x:Name="PageRoot" Opacity="1" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><TranslateTransform x:Name="PageOffset" Y="0"/></Grid.RenderTransform>
                        <Grid x:Name="HomePage">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MINTY DESKTOP  /  01" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MintDim}"/>
                                    <TextBlock Text="Играй по-своему." FontSize="32" FontWeight="Bold" Margin="0,7,0,3"/>
                                    <TextBlock Text="Твои версии, твои правила, одна точка входа." FontSize="13" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#15241E" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="11,7" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Mint}" Margin="0,0,8,0"/><TextBlock Text="ENGINE READY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Mint}"/></StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Background="#172923" BorderBrush="#365347" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ТВОЯ JAVA EDITION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Mint}"/>
                                        <TextBlock Text="Готов к запуску?" FontSize="26" FontWeight="Bold" Margin="0,8,0,4"/>
                                        <TextBlock Text="Выбери версию или установи её. Minty проверит официальные файлы и подготовит Java." FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="520"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,21,0,0">
                                            <Button x:Name="PlayButton" Content="▶   Запустить игру" Style="{StaticResource ActionButton}" Click="Play_Click"/>
                                            <Button x:Name="InstallButton" Content="↓   Установить" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Install_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#10201A" BorderBrush="#2C493B" BorderThickness="1" CornerRadius="10" Padding="14" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="АКТИВНАЯ ВЕРСИЯ" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                            <ComboBox x:Name="VersionPicker" Style="{StaticResource ChoiceBox}" Margin="0,8,0,0" SelectionChanged="VersionPicker_SelectionChanged"/>
                                            <TextBlock x:Name="LatestLabel" Text="Последний релиз загружается…" FontSize="10" Foreground="{StaticResource MintDim}" Margin="1,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="＋   Обновить список версий" Style="{StaticResource SecondaryButton}" Click="RefreshVersions_Click"/>
                                            <Button Grid.Column="2" Content="⚙   Параметры игры" Style="{StaticResource SecondaryButton}" Click="SettingsNav_Click"/>
                                        </Grid>
                                        <TextBlock Text="Vanilla Java Edition · официальный манифест Mojang" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="СОСТОЯНИЕ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                                        <TextBlock x:Name="StatusHeadline" Text="Запуск готов" FontSize="16" FontWeight="Bold" Margin="0,13,0,4"/>
                                        <TextBlock x:Name="StatusDescription" Text="Подключаемся к официальному каталогу версий." FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                        <Grid x:Name="VersionsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="MINTY DESKTOP  /  02" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MintDim}"/>
                                <TextBlock Text="Версии Minecraft" FontSize="30" FontWeight="Bold" Margin="0,7,0,3"/>
                                <TextBlock Text="Официальный список Mojang, поиск по релизам и снимкам." FontSize="13" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,20,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="VersionSearch" Style="{StaticResource FieldBox}" TextChanged="VersionSearch_TextChanged" ToolTip="Фильтр по названию версии"/>
                                <ComboBox x:Name="VersionFilter" Grid.Column="2" Style="{StaticResource ChoiceBox}" SelectionChanged="VersionFilter_SelectionChanged">
                                    <ComboBoxItem Content="Все типы" IsSelected="True"/><ComboBoxItem Content="Release"/><ComboBoxItem Content="Snapshot"/><ComboBoxItem Content="Old Beta"/><ComboBoxItem Content="Old Alpha"/>
                                </ComboBox>
                                <Button Grid.Column="4" Content="↻   Обновить" Style="{StaticResource SecondaryButton}" Click="RefreshVersions_Click"/>
                            </Grid>
                            <ListBox x:Name="VersionList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="VersionList_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1B3026"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource MintDim}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#668774"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="{Binding Id}" FontSize="15" FontWeight="Bold"/><TextBlock Text="{Binding ReleaseTime}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/></StackPanel>
                                            <Border Grid.Column="1" Background="#172820" CornerRadius="10" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Type}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Mint}"/></Border>
                                            <TextBlock Grid.Column="2" Text="Выбрать  →" FontSize="10" Foreground="{StaticResource MintDim}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Grid x:Name="ModsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="MINTY DESKTOP  /  03" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MintDim}"/>
                                <TextBlock Text="Моды и сборки" FontSize="30" FontWeight="Bold" Margin="0,7,0,3"/>
                                <TextBlock Text="Подбирай проекты Modrinth. Моды устанавливаются в профиль; модлоадер пока устанавливается отдельно." FontSize="13" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,20,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="140"/><ColumnDefinition Width="10"/><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="ModsSearch" Style="{StaticResource FieldBox}" ToolTip="Название проекта" KeyDown="ModsSearch_KeyDown"/>
                                <ComboBox x:Name="ModsCategory" Grid.Column="2" Style="{StaticResource ChoiceBox}"><ComboBoxItem Content="Моды" Tag="mod" IsSelected="True"/><ComboBoxItem Content="Модпаки" Tag="modpack"/><ComboBoxItem Content="Ресурс-паки" Tag="resourcepack"/><ComboBoxItem Content="Шейдеры" Tag="shader"/></ComboBox>
                                <ComboBox x:Name="ModsSort" Grid.Column="4" Style="{StaticResource ChoiceBox}" ToolTip="Сортировка каталога">
                                    <ComboBoxItem Content="Популярные" Tag="downloads" IsSelected="True"/><ComboBoxItem Content="По новизне" Tag="newest"/><ComboBoxItem Content="По обновлению" Tag="updated"/><ComboBoxItem Content="По релевантности" Tag="relevance"/>
                                </ComboBox>
                                <Button x:Name="ModsSearchButton" Grid.Column="6" Content="⌕   Найти" Style="{StaticResource ActionButton}" Click="ModsSearch_Click"/>
                            </Grid>
                            <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12">
                                <DockPanel LastChildFill="True">
                                    <TextBlock x:Name="ModsStatus" DockPanel.Dock="Top" Text="Каталог Modrinth готов к поиску." FontSize="10" Foreground="{StaticResource TextMuted}" Margin="4,2,4,10"/>
                                    <ListBox x:Name="ModsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" ClipToBounds="True"><ContentPresenter HorizontalAlignment="Stretch"/></Border></ControlTemplate></Setter.Value></Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinWidth="0" ClipToBounds="True">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel MinWidth="0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Author}" FontSize="10" Foreground="{StaticResource MintDim}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,7,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                                                        <TextBlock Text="{Binding Downloads, StringFormat={}{0:N0} загрузок}" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,7,0,0"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" MinWidth="104" Height="38" Padding="10,0" VerticalAlignment="Center" Click="ModInstall_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                                <Setter Property="Content" Value="Установить"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProjectType}" Value="modpack">
                                                                        <Setter Property="Content" Value="Открыть сайт"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <Button Grid.Row="3" Content="Открыть папку модов" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenModsFolder_Click"/>
                        </Grid>
                        <Grid x:Name="SettingsPage" Visibility="Collapsed">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="MINTY DESKTOP  /  04" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MintDim}"/>
                                <TextBlock Text="Настройки" FontSize="30" FontWeight="Bold" Margin="0,7,0,3"/>
                                <TextBlock Text="Управляй профилем, файлами игры и Java runtime." FontSize="13" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,20,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                                        <TextBlock Text="ПРОФИЛЬ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Mint}" Margin="0,0,0,12"/>
                                        <TextBlock Text="Имя офлайн-профиля" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="UsernameBox" Style="{StaticResource FieldBox}"/>
                                        <TextBlock Text="ПАПКА ИГРЫ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Mint}" Margin="0,22,0,12"/>
                                        <TextBlock Text="Minecraft directory" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBox x:Name="GameDirectoryBox" Style="{StaticResource FieldBox}"/><Button Grid.Column="2" Content="Выбрать папку" Style="{StaticResource SecondaryButton}" Click="BrowseGameDirectory_Click"/></Grid>
                                        <TextBlock Text="JAVA RUNTIME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Mint}" Margin="0,22,0,12"/>
                                        <TextBlock Text="Путь к java.exe / javaw.exe (пусто — автоматическая загрузка)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="JavaPathBox" Style="{StaticResource FieldBox}"/><Button Grid.Column="2" Content="Обзор…" Style="{StaticResource SecondaryButton}" Click="BrowseJava_Click"/></Grid>
                                        <TextBlock Text="ЗАГРУЗЧИК МОДОВ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Mint}" Margin="0,22,0,12"/>
                                        <TextBlock Text="Используется для фильтра совместимости; сам загрузчик нужно установить отдельно" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="ModLoaderPicker" Style="{StaticResource ChoiceBox}"><ComboBoxItem Content="Vanilla" IsSelected="True"/><ComboBoxItem Content="Fabric"/><ComboBoxItem Content="Forge"/><ComboBoxItem Content="NeoForge"/><ComboBoxItem Content="Quilt"/></ComboBox>
                                        <TextBlock Text="ПАМЯТЬ JVM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Mint}" Margin="0,22,0,12"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><Slider x:Name="MemorySlider" Minimum="1024" Maximum="32768" TickFrequency="1024" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="MemorySlider_ValueChanged"/><TextBlock x:Name="MemoryLabel" Grid.Column="1" Text="4096 MB" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid>
                                        <CheckBox x:Name="WeakPcCheck" Content="Щадящие параметры JVM для слабого ПК" Foreground="{StaticResource TextPrimary}" Margin="0,15,0,0"/>
                                        <CheckBox x:Name="AnimationsCheck" Content="Плавные переходы интерфейса" Foreground="{StaticResource TextPrimary}" Margin="0,11,0,0"/>
                                        <CheckBox x:Name="IsolatedProfilesCheck" Content="Отдельные папки worlds/mods для каждой версии" Foreground="{StaticResource TextPrimary}" Margin="0,11,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,24,0,8"><Button Content="Сохранить настройки" Style="{StaticResource ActionButton}" Click="SaveSettings_Click"/><TextBlock x:Name="SettingsStatus" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11" Foreground="{StaticResource Mint}"/></StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="#101A16" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="22,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="FooterStatus" Text="Подключаемся к игровому движку…" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="FooterDetails" Text="Minty Launcher 2.0.0-global" FontSize="9" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed" x:Name="DownloadPanel">
                        <Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DownloadFile" Text="Загрузка" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/><TextBlock x:Name="DownloadStats" Grid.Column="1" Text="0,0 МБ/с  ·  --:--" FontSize="9" Foreground="{StaticResource Mint}"/></Grid>
                        <ProgressBar x:Name="DownloadProgress" Height="4" Minimum="0" Maximum="100" Value="0" Background="#263831" Foreground="{StaticResource Mint}" BorderThickness="0"/>
                        <Button Content="Отменить операцию" Height="18" HorizontalAlignment="Right" Padding="6,0" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="9" Cursor="Hand" Click="CancelOperation_Click"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#1A2B23" CornerRadius="14" Padding="10,6" Margin="20,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource Mint}" Margin="0,0,7,0"/><TextBlock Text="MINTY ENGINE" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Mint}"/></StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
