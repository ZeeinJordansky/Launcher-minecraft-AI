<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>minty-launcher</AssemblyName>
    <RootNamespace>MintyLauncher</RootNamespace>
    <Version>2.1.0</Version>
    <InformationalVersion>2.1.0</InformationalVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationIcon Condition="Exists('../scripts/installer/Minty.ico')">../scripts/installer/Minty.ico</ApplicationIcon>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <TrimMode>full</TrimMode>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="assets/**" />
  </ItemGroup>
</Project>
